generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String         @id @default(cuid())
  ownerId                String?
  name                   String?
  email                  String         @unique
  role                   Role           @default(SHOPKEEPER)
  primaryCodeId          String?
  shopName               String?
  shopStatus             ShopStatus     @default(ACTIVE)
  shopExpiry             DateTime?
  address                String?
  phone                  String?
  passwordHash           String?
  mustChangePassword     Boolean        @default(false)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  owner                  User?          @relation("TenantMembership", fields: [ownerId], references: [id], onDelete: SetNull)
  members                User[]         @relation("TenantMembership")
  primaryCode            Code?          @relation("UserPrimaryCode", fields: [primaryCodeId], references: [id], onDelete: SetNull)
  accounts               Account[]
  createdNotifications   Notification[] @relation("NotificationCreatedBy")
  notifications          Notification[] @relation("NotificationUser")
  products               Product[]
  createdSales           Sale[]         @relation("SaleCreatedBy")
  ownedSales             Sale[]         @relation("SaleOwner")
  sessions               Session[]
  ownedCodes             Code[]         @relation("CodeOwner")
  codeAssignments        UserCode[]     @relation("UserCodeUser")
  codeAssignmentsOwned   UserCode[]     @relation("UserCodeOwner")
  codeAssignmentsCreated UserCode[]     @relation("UserCodeAssignedBy")

  @@index([ownerId, role, createdAt])
  @@index([role, createdAt])
  @@index([role, shopStatus])
  @@index([role, shopExpiry])
}

model Code {
  id              String     @id @default(cuid())
  ownerId         String
  value           String
  normalizedValue String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  owner           User       @relation("CodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  users           UserCode[]
  primaryForUsers User[]     @relation("UserPrimaryCode")

  @@unique([ownerId, normalizedValue])
  @@index([ownerId, value])
}

model UserCode {
  id           String   @id @default(cuid())
  ownerId      String
  userId       String
  codeId       String
  assignedById String?
  assignedAt   DateTime @default(now())
  owner        User     @relation("UserCodeOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  user         User     @relation("UserCodeUser", fields: [userId], references: [id], onDelete: Cascade)
  code         Code     @relation(fields: [codeId], references: [id], onDelete: Restrict)
  assignedBy   User?    @relation("UserCodeAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([ownerId, userId, codeId])
  @@index([ownerId, userId, assignedAt])
  @@index([ownerId, codeId])
}

model AppSetting {
  id              String   @id @default(cuid())
  appName         String   @default("Inventory Cloud")
  appDescription  String   @default("Stock, orders, and insights")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Product {
  id           String        @id @default(cuid())
  name         String
  sku          String
  description  String?
  price        Decimal       @db.Decimal(10, 2)
  quantity     Int           @default(0)
  status       ProductStatus @default(ACTIVE)
  reorderLevel Int           @default(5)
  ownerId      String
  serialNumber Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  sales        Sale[]

  @@unique([ownerId, sku])
  @@unique([ownerId, serialNumber])
  @@index([ownerId, quantity])
}

model Sale {
  id          String   @id @default(cuid())
  ownerId     String
  productId   String
  quantity    Int
  total       Decimal  @default(0.00) @db.Decimal(10, 2)
  createdById String
  createdAt   DateTime @default(now())
  owner       User     @relation("SaleOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdBy   User     @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([createdById, createdAt])
  @@index([productId, createdAt])
}

model Notification {
  id          String   @id @default(cuid())
  title       String?
  message     String
  channel     String   @default("IN_APP")
  userId      String?
  createdById String?
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  user        User?    @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdById, createdAt])
}

enum Role {
  ADMIN
  SHOPKEEPER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  SOLD
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
}
